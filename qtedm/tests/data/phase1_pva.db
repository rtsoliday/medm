record(ao, "$(P)led:test:discrete") {
  field(DESC, "QtEDM Phase 1 symbol PVA source")
  field(VAL, "3")
  field(DRVL, "0")
  field(DRVH, "10")
  field(PREC, "0")
}

record(bo, "$(P)led:test:binary_live") {
  field(DESC, "QtEDM Phase 1 toggle PVA source")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
  field(VAL, "1")
}

record(ao, "$(P)sp:test:compact:setpoint") {
  field(DESC, "QtEDM Phase 1 spinbox PVA source")
  field(VAL, "37.5")
  field(DRVL, "-10")
  field(DRVH, "100")
  field(PREC, "2")
  field(EGU, "V")
}
