record(ao, "$(P)led:test:discrete") {
  field(DESC, "QtEDM symbol PVA source")
  field(VAL, "3")
  field(DRVL, "0")
  field(DRVH, "10")
  field(PREC, "0")
}

record(bo, "$(P)led:test:binary_live") {
  field(DESC, "QtEDM toggle PVA source")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
  field(VAL, "1")
}

record(ao, "$(P)sp:test:compact:setpoint") {
  field(DESC, "QtEDM spinbox PVA source")
  field(VAL, "37.5")
  field(DRVL, "-10")
  field(DRVH, "100")
  field(PREC, "2")
  field(EGU, "V")
}

record(stringout, "$(P)pva:test:string") {
  field(DESC, "QtEDM PVA string write source")
  field(VAL, "PVA_INITIAL")
}

record(mbbo, "$(P)pva:test:enum") {
  field(DESC, "QtEDM PVA enum write source")
  field(ZRST, "Idle")
  field(ONST, "Running")
  field(TWST, "Complete")
  field(THST, "Fault")
  field(VAL, "1")
}

record(waveform, "$(P)pva:test:array") {
  field(DESC, "QtEDM PVA numeric array source")
  field(FTVL, "DOUBLE")
  field(NELM, "8")
}
