  }
  textix="QtEDM Phase 2 - Lazy Tabbed Child Displays"
  align="horiz. centered"
}
qtedm_tabbed_display {
  object {
    x=20
    y=50
    width=660
    height=350
  }
  mode="tabs"
  active_page="live"
  page {
    id="live"
    label="Live Overview"
    display="qtedm_phase2_child_live.adl"
    macros="TITLE=Live Overview,DETAIL=Inactive pages unsubscribe"
    keepAlive="false"
  }
  page {
    id="retained"
    label="Retained"
    display="qtedm_phase2_child_retained.adl"
    macros="TITLE=Retained Page,DETAIL=keepAlive retains subscriptions"
    keepAlive="true"
  }
  page {
    id="missing"
    label="Missing Child"
    display="qtedm_phase2_missing.adl"
    keepAlive="false"
  }
  page {
    id="recursive"
    label="Recursive Guard"
    display="test_QtEDMPhase2.adl"
    keepAlive="false"
  }
}
