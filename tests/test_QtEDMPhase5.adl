qtedm_plugin {
  pluginId="org.qtedm.phase5.missing-fixture"
  typeId="operator_status"
  schemaVersion="1"
  object {
    x="80"
    y="105"
    width="500"
    height="110"
  }
  property {
    name="text"
    type="string"
    value="WAITING"
  }
  future_extension {
    opaque="preserve-on-save"
  }
}
text {
  object {
    x=20
    y=15
    width=620
    height=30
  }
  "basic attribute" {
    clr=14
  }
  textix="QtEDM Phase 5: Plugins + Rules"
  align="horiz. centered"
}
text {
  object {
    x=30
    y=55
    width=600
    height=22
  }
  "basic attribute" {
    clr=14
  }
  textix="Missing plugin ADL stays recoverable. Rule input: led:test:binary_live."
  align="horiz. centered"
}
text {
  object {
    x=30
    y=235
    width=600
    height=22
  }
  "basic attribute" {
    clr=14
  }
  textix="Value 1: RUNNING + visible. Value 0: STOPPED + hidden."
  align="horiz. centered"
}
text {
  object {
    x=30
    y=265
    width=600
    height=22
  }
  "basic attribute" {
    clr=14
  }
  textix="Rules never write PVs. Save/reopen preserves the opaque plugin child."
  align="horiz. centered"
}
qtedm_rules {
  targetIndex=0
  rule {
    id="status_text"
    property="text"
    expression="A!=0"
    trueValue="RUNNING"
    falseValue="STOPPED"
    disconnect="restore"
    rateHz=10
    input {
      variable="A"
      channel="led:test:binary_live"
      type="number"
    }
  }
  rule {
    id="status_visible"
    property="visibility"
    expression="A!=0"
    trueValue="true"
    falseValue="false"
    disconnect="restore"
    rateHz=10
    input {
      variable="A"
      channel="led:test:binary_live"
      type="number"
    }
  }
}
