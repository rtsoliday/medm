text {
  object {
    x=20
    y=10
    width=600
    height=24
  }
  "basic attribute" {
    clr=54
  }
  textix="QtEDM Observe-Only and Safety Controls"
  align="horiz. centered"
}
qtedm_symbol {
  object {
    x=30
    y=55
    width=180
    height=120
  }
  monitor {
    chan="led:test:discrete"
    clr=15
    bclr=14
  }
  colorMode="discrete"
  shape="square"
  bezel=0
  stateCount=3
  onColor=30
  offColor=20
  undefinedColor=2
  stateColor0=20
  stateColor1=30
  stateColor2=15
  state {
    min=0
    max=0
    color=20
    label="Stopped"
  }
  state {
    min=1
    max=2
    color=30
    label="Starting"
  }
  state {
    min=3
    max=10
    color=15
    label="Running"
    image="optional-running.png"
  }
}
qtedm_toggle {
  object {
    x=235
    y=55
    width=160
    height=42
  }
  control {
    chan="led:test:binary_live"
    clr=14
    bclr=45
  }
  label="Enable"
  offValue="0"
  onValue="1"
  offLabel="Disabled"
  onLabel="Enabled"
  confirm=1
  clrmod="alarm"
}
qtedm_spinbox {
  object {
    x=235
    y=120
    width=370
    height=48
  }
  "basic attribute" {
    clr=14
    bclr=43
  }
  label="Demand"
  setpoint="sp:test:compact:setpoint"
  readback=""
  colorMode="alarm"
  showReadback=0
  step=0.25
  limits {
    loprSrc="default"
    loprDefault=-10
    hoprSrc="default"
    hoprDefault=100
    precSrc="default"
    precDefault=2
  }
}
text {
  object {
    x=30
